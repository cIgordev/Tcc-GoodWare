# Examples only. Export variables in your shell; Spring does NOT load .env automatically.
GOODWARE_DB_URL=jdbc:postgresql://<HOST_FROM_SUPABASE_CONNECT>:5432/postgres
GOODWARE_DB_USER=<RESTRICTED_LOGIN_FROM_CONNECT>
GOODWARE_DB_PASSWORD=<LOCAL_SECRET_DO_NOT_COMMIT>
GOODWARE_DB_SSL_ROOT_CERT=<ABSOLUTE_PATH_TO_SUPABASE_CA_CERTIFICATE>
GOODWARE_MIGRATE=false
# Temporary migration administrator; remove after migrating.
GOODWARE_MIGRATION_URL=jdbc:postgresql://<DIRECT_OR_SESSION_HOST>:5432/postgres?sslmode=verify-full&sslrootcert=<ABSOLUTE_CA_PATH>
GOODWARE_MIGRATION_USER=<MIGRATION_ADMIN>
GOODWARE_MIGRATION_PASSWORD=<LOCAL_MIGRATION_SECRET>
# Keep false for a new database. Do not baseline an unverified existing schema.
GOODWARE_BASELINE_EXISTING=false

# Public key is NOT a server secret. Default already targets tccgoodware.
GOODWARE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aG00-6_b0ZpCjM-cWBYnhA_gep7780v
# Future deployment only; do not activate before HTTPS/proxy validation.
# SPRING_PROFILES_ACTIVE=public
# GOODWARE_PUBLIC_ORIGIN=https://your-domain.example
# GOODWARE_TRUSTED_PROXY_REGEX=explicit_proxy_ip_regex
